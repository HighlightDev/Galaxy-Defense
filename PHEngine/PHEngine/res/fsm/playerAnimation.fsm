<FSM>
  <states>
    <state>
      name: "Idle"
    </state>
    <state>
      name: "Walking"
    </state>
  </states>
  <transitions>
    <transition>
      name: "StartWalk"
      from_state: "Idle"
      to_state: "Walking"
      duration: 0.5
    </transition>
    <transition>
      name: "Stop"
      from_state: "Walking"
      to_state: "Idle"
      duration: 0.5
    </transition>
  </transitions>
  <bindings>
    <binding>
      binding_name: "animationBinding"
      type: "animation"
    </binding>
  </bindings>
  <properties>
    <property>
      name: "Idle"
      mutual_name: "PropertyAnimation"
      binding_name: "animationBinding"
      type: "animation"
      value: "Iddle"
      state: "Walking"
    </property>
    <property>
      name: "AnimationWalking"
      mutual_name: "PropertyAnimation"
      binding_name: "animationBinding"
      type: "animation"
      value: "Armature|Walk"
      state: "Idle"
    </property>
  </properties>
</FSM>